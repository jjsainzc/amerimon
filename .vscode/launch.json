{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Backend Go",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "envFile": "${workspaceFolder}/.vscode/ami.env",
      "program": "${workspaceFolder}/cmd/amerimon",
      "cwd": "${workspaceFolder}",
      "args": [
        "-config", "packaging/amerimon.yaml",
        "-addr", "127.0.0.1:8082",
        "-db", "/tmp/amerimon-dev.db"
      ],
      "env": {
        "AMERIMON_JWT_SECRET": "dev-secret",
        "AMERIMON_ENV_FILE": "${workspaceFolder}/.vscode/ami.env"
      }
    },
    {
      "name": "ng test",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: test",
      "url": "http://localhost:9876/debug.html"
    }
  ],
  "compounds": [
    {
      "name": "Angular + Go",
      "preLaunchTask": "Preparar AMI para depurar",
      "configurations": ["Backend Go", "ng serve"],
      "stopAll": true
    }
  ]
}
